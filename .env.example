# 复制为 .env 后填写；.env 不入库
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# SQLite 数据库、导入的 EPUB、封面、日志都放在这里
DATA_DIR=./data
HOST=127.0.0.1
PORT=8000
# development 会记录每次发给 LLM 的内容；默认 production
APP_ENV=development
# 生成逐章摘要时带入的最近已读章节数
SUMMARY_CONTEXT_CHAPTERS=3
# 前端单独部署到其他域名时填写，逗号分隔，如 https://read.example.com；同源部署留空
CORS_ORIGINS=
